# --- General / OS Files ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# --- Security (CRITICAL) ---
# Ignores all environment files containing API keys
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local

# --- Python Backend ---
backend/venv/
backend/env/
backend/__pycache__/
*.py[cod]
*$py.class
backend/.pytest_cache/
backend/coverage/
backend/htmlcov/

# --- Node/React Frontend ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/npm-debug.log
frontend/yarn-error.log
frontend/yarn.lock
frontend/package-lock.json
# (Note: Keep package-lock.json if you want to lock versions, 
# but often it's ignored in simple projects. 
# Usually, keep it. If you want to exclude it, uncomment the line above.)

# --- Database ---
*.sqlite3
*.db
backend/skyline.db

# --- Testing / Pytest ---
.coverage